---
import Base from "../layouts/Base.astro";
import { site, menus, imgSrcset, url } from "../data/site";
---

<Base title={`MENUS — ${site.name.toUpperCase()}`} current="menus">
  <section class="page-head">
    <p class="page-eyebrow">The menus</p>
    <h1>Printed nightly</h1>
    <p class="page-intro">
      The tasting menu is the whole evening; the rest is for shorter ones.
      Every menu below is printed in full — allergies and the vegetal menu
      are planned for gladly, just tell us when you reserve.
    </p>
  </section>

  <section class="menu-cards" aria-label="All menus">
    <h2 class="section-label">All menus</h2>
    {
      menus.map((m, i) => (
        <article class={`menu-card reveal ${i % 2 ? "flip" : ""}`}>
          <a href={url(`/${m.slug}`)} aria-label={`View menu: ${m.title}`}>
            <img
              src={url(m.image)}
              alt={m.imageAlt}
              width="904"
              height="602"
              loading="lazy"
              srcset={imgSrcset(m.image, [480, 960], 904)}
              sizes="(max-width: 760px) 92vw, 44vw"
            />
          </a>
          <div class="feature-meta">
            <p class="feature-kicker">{m.note}</p>
            <h3>{m.title}</h3>
            <p>{m.summary}</p>
            <p class="feature-price">{m.price}</p>
            <a class="text-link" href={url(`/${m.slug}`)}>
              Read the menu: {m.title}
            </a>
          </div>
        </article>
      ))
    }
  </section>

  <section class="service-detail-list" aria-label="The experiences in detail">
    <h2 class="section-label">The experiences</h2>
    {
      site.services.map((s, i) => (
        <article class="service-detail reveal">
          <span class="service-num">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h2>{s.title}</h2>
            <p>{s.summary}</p>
            <ul class="chip-list">
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </section>
</Base>
