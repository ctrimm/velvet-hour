---
import Base from "../layouts/Base.astro";
import PressList from "../components/PressList.astro";
import { site, menus, imgSrcset, url, headlineParts } from "../data/site";

const home = site.home;
---

<Base title={`${site.name.toUpperCase()}`} current="home">
  <!-- Hero -->
  <section class="hero">
    <figure class="hero-photo">
      <img
        src={url(home.heroImage)}
        alt={home.heroImageAlt}
        width="1920"
        height="1280"
        fetchpriority="high"
        srcset={imgSrcset(home.heroImage, [640, 960, 1440], 1920)}
        sizes="92vw"
      />
    </figure>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">{home.eyebrow}</p>
      <h1 class="hero-headline">
        {
          home.headline.map((line) => (
            <span class="hero-line">
              {headlineParts(line).map((part) =>
                part.italic ? <em>{part.text}</em> : <>{part.text}</>
              )}
            </span>
          ))
        }
      </h1>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="manifesto reveal" aria-label="Restaurant philosophy">
    {home.manifesto.map((p) => <p>{p}</p>)}
    <dl class="stats">
      {
        home.stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Experiences index -->
  <section class="services-index reveal" aria-label="The experiences">
    <h2 class="section-label">The experiences</h2>
    <ul class="service-rows">
      {
        site.services.map((s, i) => (
          <li>
            <a href={url("/menus")}>
              <span class="service-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="service-name">{s.title}</span>
              <span class="service-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Featured menus -->
  <section class="featured" aria-label="Featured menus">
    <h2 class="section-label">The menus</h2>
    {
      menus.slice(0, 3).map((m, i) => (
        <article class={`feature-row reveal ${i % 2 ? "flip" : ""}`}>
          <a href={url(`/${m.slug}`)} aria-label={`View menu: ${m.title}`}>
            <img
              src={url(m.image)}
              alt={m.imageAlt}
              width="904"
              height="602"
              loading="lazy"
              srcset={imgSrcset(m.image, [480, 960], 904)}
              sizes="(max-width: 760px) 92vw, 44vw"
            />
          </a>
          <div class="feature-meta">
            <p class="feature-kicker">{m.note}</p>
            <h3>{m.title}</h3>
            <p>{m.summary}</p>
            <p class="feature-price">{m.price}</p>
            <a class="text-link" href={url(`/${m.slug}`)}>
              Read the menu: {m.title}
            </a>
          </div>
        </article>
      ))
    }
  </section>

  <!-- An evening, hour by hour -->
  <section class="process-strip reveal" aria-label="An evening">
    <h2 class="section-label">An evening, hour by hour</h2>
    <div class="process-grid">
      {
        site.process.map((p) => (
          <div class="process-step">
            <span class="process-num">{p.step}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <PressList />

  <!-- Closing CTA -->
  <section class="closing reveal">
    <p class="closing-line">The candles are lit at five-thirty.</p>
    <a class="pill-link" href={url("/visit")}>Reserve an evening</a>
  </section>
</Base>
